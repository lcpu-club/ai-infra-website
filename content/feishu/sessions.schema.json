{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feishu course sync configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessions"],
  "properties": {
    "$schema": { "type": "string" },
    "wiki": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootNodeToken", "sourceBaseUrl"],
      "properties": {
        "rootNodeToken": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "sourceBaseUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^?#]+/wiki/?$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
          "properties": {
            "id": { "type": "string", "pattern": "^\\d{2}$" },
            "wikiNodeToken": { "type": "string" },
            "pageTitle": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
